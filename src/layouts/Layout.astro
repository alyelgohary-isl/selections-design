---
/* Shared page shell: head tags, header, footer and site-wide scripts.
   Page content goes in the default slot; anything extra for <head> goes in slot="head". */
import "../styles/style.css";
import "../styles/selections.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, type NavKey } from "../site.config";
import { url, absolute, SITE_URL } from "../lib/url";

interface Props {
  /** SEO title, ≤ 60 characters */
  title: string;
  /** Meta description, ≤ 155 characters */
  description: string;
  /** Path on the production domain, e.g. "about/" ("" for home) */
  path: string;
  /** Nav item to mark as the current page */
  current?: NavKey;
  ogImage?: string;
  /** Extra JSON-LD objects (breadcrumbs, FAQ, products…); the Organization block is always included */
  schema?: object[];
  /** "inner" for regular pages; "film" for a page led by a pinned scroll sequence (no CSS smooth scroll) */
  variant?: "inner" | "film";
}

const { title, description, path, current, ogImage = site.ogImage, schema = [], variant = "inner" } = Astro.props;
const canonical = absolute(path);

const ORGANIZATION = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: SITE_URL,
  email: site.email,
  description: site.description,
  slogan: site.tagline,
  ...site.schema,
};
const { gtm, ga4, gscVerification } = site.tracking;
const { letter, background, color } = site.favicon;
const FAVICON = "data:image/svg+xml," + encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='${background}'/><text x='16' y='23' text-anchor='middle' font-family='Georgia,serif' font-size='20' fill='${color}'>${letter}</text></svg>`
);
---
<!DOCTYPE html>
<html lang="en" class={variant === "inner" ? "inner" : undefined}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {/* Colourway review: ?theme=forest|blueprint|prussian|brass|cyanotype|sage|hivis|oxblood|current picks a colourway for this tab (see selections.css). Remove with the themes once one is chosen. */}
  <script is:inline>
    (function () { try {
      var q = new URLSearchParams(location.search).get("theme"), s = sessionStorage;
      if (q !== null) s.setItem("theme", q);
      var t = s.getItem("theme");
      if (t !== null) { document.documentElement.setAttribute("data-review", ""); if (t && t !== "current") document.documentElement.setAttribute("data-theme", t); }
    } catch (e) {} })();
  </script>
  {gtm && <script define:vars={{ gtm }}>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
    var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
    j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',gtm);
  </script>}
  {!gtm && ga4 && <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>}
  {!gtm && ga4 && <script define:vars={{ ga4 }}>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    gtag('js', new Date());
    gtag('config', ga4);
    // without GTM nothing maps form_success, so site.js calls this directly
    window.trackLead = function (params) { gtag('event', 'generate_lead', params); };
  </script>}
  {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
  {site.noindex && <meta name="robots" content="noindex, nofollow" />}
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={absolute(ogImage)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={site.fonts} rel="stylesheet" />
  <link rel="icon" href={FAVICON} />
  {[ORGANIZATION, ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <slot name="head" />
</head>
<body class={variant}>
  {gtm && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtm}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>}
  <Header current={current} />
  <slot />
  <Footer />
  <!-- public/js/config.js holds the form endpoint and reCAPTCHA key; it stays a plain, unbundled file so it is easy to find and edit -->
  <script is:inline src={url("js/config.js")}></script>
  <div class="theme-review" role="group" aria-label="Colourway review">
    <button type="button" data-set="current"><i style="background:#ece5d6"></i><i style="background:#1c1713"></i><i style="background:#b5381f"></i><span>Current</span></button>
    <button type="button" data-set="forest"><i style="background:#e7e5de"></i><i style="background:#151714"></i><i style="background:#1d5a41"></i><span>Forest</span></button>
    <button type="button" data-set="blueprint"><i style="background:#eef1f3"></i><i style="background:#0e1a2b"></i><i style="background:#1f4fd6"></i><span>Blueprint</span></button>
    <button type="button" data-set="prussian"><i style="background:#eef0f1"></i><i style="background:#14171b"></i><i style="background:#123f7a"></i><span>Prussian</span></button>
    <button type="button" data-set="brass"><i style="background:#16120e"></i><i style="background:#ebe4d5"></i><i style="background:#c8a25c"></i><span>Brass</span></button>
    <button type="button" data-set="cyanotype"><i style="background:#12397a"></i><i style="background:#f2f6fa"></i><i style="background:#8fe6c4"></i><span>Cyanotype</span></button>
    <button type="button" data-set="sage"><i style="background:#c8d1c0"></i><i style="background:#15241b"></i><i style="background:#5b2248"></i><span>Sage</span></button>
    <button type="button" data-set="hivis"><i style="background:#c9cac6"></i><i style="background:#101010"></i><i style="background:#e2f02c"></i><span>Hi-vis</span></button>
    <button type="button" data-set="oxblood"><i style="background:#2a0c11"></i><i style="background:#f1ddd6"></i><i style="background:#a9d8c0"></i><span>Oxblood</span></button>
  </div>
  <script is:inline>
    (function () {
      var root = document.documentElement, btns = document.querySelectorAll(".theme-review button");
      function mark() { var cur = root.getAttribute("data-theme") || "current"; btns.forEach(function (b) { b.setAttribute("aria-pressed", String(b.getAttribute("data-set") === cur)); }); }
      btns.forEach(function (b) { b.addEventListener("click", function () {
        var v = b.getAttribute("data-set");
        try { sessionStorage.setItem("theme", v); } catch (e) {}
        if (v === "current") root.removeAttribute("data-theme"); else root.setAttribute("data-theme", v);
        mark();
      }); });
      mark();
    })();
  </script>
  <script>import "../scripts/site.js";</script>
  <script>import "../scripts/sheets.js";</script>
</body>
</html>
