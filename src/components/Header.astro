---
import { site, type NavKey } from "../site.config";
import { url } from "../lib/url";

interface Props {
  /** Nav item marked aria-current="page" */
  current?: NavKey;
}
const { current } = Astro.props;
const [first, second] = site.brand;
---
<header class="site-header">
  <a class="brand" href={url()} aria-label={site.name}>{first}<span class="brand-tag">{second}</span></a>
  <nav class="site-nav" id="site-nav" aria-label="Primary">
    {site.nav.map((item, i) => (
      <a href={url(item.href)} aria-current={item.key === current ? "page" : undefined}><span class="nav-no">A-{i + 1}</span>{item.label}</a>
    ))}
    <a class="header-cta" href={url(site.cta.href)}>{site.cta.label}</a>
  </nav>
  <div class="header-right">
    <a class="header-cta" href={url(site.cta.href)}>{site.cta.label}</a>
    <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav"><span></span></button>
  </div>
</header>
